{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "description": "Debug output is on."
  },
  "landingPage": "/wp-admin/admin.php?page=my-plugin",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true
      }
    },
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "{{ZIP_URL}}"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
